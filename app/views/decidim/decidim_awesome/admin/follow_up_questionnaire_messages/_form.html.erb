<%= form.hidden_field :decidim_user_id %>
<%= form.hidden_field :session_token %>

<div class="row column">
  <%= form.select :author_id,
                  form.object.possible_authors.map { |author| [author.name, author.id] },
                  label: t(".author") %>
</div>

<div class="row column">
  <%= form.select :status_id,
                  @statuses.map { |status| [translated_attribute(status.name), status.id] },
                  include_blank: t(".select_a_status"),
                  label: t(".status") %>
</div>

<div class="row column">
  <%= form.editor :body, toolbar: "basic", label: t(".body"), help_text: t(".body_help") %>
</div>

<div class="row column">
  <%= form.attachment :attachments,
                      multiple: true,
                      titled: false,
                      label: t(".attachments"),
                      button_label: t(".add_attachment"),
                      button_edit_label: t(".edit_attachment"),
                      button_class: "button button__sm button__transparent-secondary",
                      help_i18n_scope: "decidim.forms.file_help.attachment" %>
</div>
