<div class="form__wrapper">
  <% follow_up_questionnaire_id = params[:id] %>
  <div class="card pt-4">
    <div class="card-section">
      <div class="row column">
        <%= form.translated :text_field, :name, class: "h-12 w-full", help_text: t(".name_help") %>
      </div>
      <%= form.hidden_field :decidim_questionnaire_id,
      value: @follow_up_questionnaire&.decidim_questionnaire_id || params[:id] || params[:decidim_questionnaire_id] %>
      <div class="row column">
        <%= form.text_field :position, class: "w-full" %>
      </div>
      <div class="row column">
        <%= form.select :responder_name_field, [], { include_blank: true, help_text: t(".responder_email_help") }, class: "mb-8" %>
      </div>
      <div class="row column">
        <%= form.select :responder_email_field, [], { include_blank: true, help_text: t(".responder_email_help") }, class: "mb-8" %>
      </div>
      <div class="row column">
        <%= render "decidim/decidim_awesome/admin/follow_up_questionnaire_statuses/table",follow_up_questionnaire_id: follow_up_questionnaire_id,statuses: @follow_up_questionnaire&.statuses %>
      </div>
    </div>
  </div>
</div>
