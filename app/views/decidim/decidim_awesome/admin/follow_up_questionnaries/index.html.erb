<div class="item_show__header">
  <h2 class="item_show__header-title">
    <%= t("decidim.decidim_awesome.admin.menu.follow_up_questionnaries") %>
    <%= link_to t(".new"), decidim_admin_decidim_awesome.new_follow_up_questionnary_path, class: "button button__sm button__secondary ml-auto" %>
  </h2>
</div>

<div class="card">
  <div class="card-section">
    <p class="help-text -mt-2 mb-4">
      <%= t(".description") %>
    </p>
    <div class="table-scroll">
      <table class="table-list">
        <thead>
          <tr>
            <th><%= t("follow_up_questionnaries.name", scope: "activemodel.attributes") %></th>
            <th><%= t("follow_up_questionnaries.participatory_space", scope: "activemodel.attributes") %></th>
            <th class="actions"><%= t("decidim.decidim_awesome.admin.actions") %></th>
          </tr>
        </thead>
        <tbody>
            <tr>
              <td></td>
              <td></td>
              <td class="table-list__actions">
                <%= icon_link_to "eye-line", "decidim_admin_decidim_awesome.follow_up_questionnary_responses_path(item)", t(".preview"), class: "action-icon--preview" %>
                <%= icon_link_to "pencil-line", "decidim_admin_decidim_awesome.edit_follow_up_questionnary_path(item)", t(".edit"), class: "action-icon--edit" %>
                <%= icon_link_to "close-circle-line"," decidim_admin_decidim_awesome.follow_up_questionnary_path(item)", t(".remove"), method: :delete, class: "action-icon--remove", data: { confirm: t(".confirm_destroy") } %>
              </td>
            </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>
